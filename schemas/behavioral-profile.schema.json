{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-attitudes.example/schemas/behavioral-profile.schema.json",
  "title": "Agent Attitudes Behavioral Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "name", "version", "description",
    "behavior", "invariants"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "kind": { "const": "behavioral-profile" },
    "name": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "minLength": 1 },
    "behavior": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/rule" }
    },
    "invariants": { "$ref": "#/$defs/invariants" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "actionIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "when": { "$ref": "#/$defs/actionIdentifier" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/actionIdentifier" }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical_accuracy", "factual_accuracy", "task_completion", "safety"
      ],
      "properties": {
        "technical_accuracy": { "const": "required" },
        "factual_accuracy": { "const": "required" },
        "task_completion": { "const": "required" },
        "safety": { "const": "required" }
      }
    }
  }
}
