{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-attitudes.example/schemas/persona-variant.schema.json",
  "title": "Agent Attitudes Persona Variant",
  "description": "A constrained specialization of one reusable persona type.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "name", "persona", "description"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "kind": { "const": "persona-variant" },
    "name": { "$ref": "#/$defs/identifier" },
    "persona": { "$ref": "#/$defs/identifier" },
    "description": { "type": "string", "minLength": 1 },
    "additional_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "presentation": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "voice": { "$ref": "persona.schema.json#/$defs/voice" },
    "experience": { "$ref": "experience.schema.json" },
    "preferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "triggers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intensity"],
        "properties": {
          "intensity": { "enum": ["low", "medium", "high", "extreme"] }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  }
}
